{
  "name": "streamoverlay-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "node server/index.js",
    "build": "vite build",
    "test:backend": "node --test tests/backend-validation.test.js",
